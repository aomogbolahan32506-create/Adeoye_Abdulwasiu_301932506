-- Complex Query: Retrieve current active/confirmed bookings with guest details and room type
SELECT 
    b.booking_id,
    CONCAT(g.first_name, ' ', g.last_name) AS guest_name,
    r.room_number,
    r.room_type,
    b.check_in_date,
    b.check_out_date,
    b.total_amount
FROM Bookings b
JOIN Guests g ON b.guest_id = g.guest_id
JOIN Rooms r ON b.room_id = r.room_id
WHERE b.booking_status = 'Confirmed';

